<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student Dashboard</title>
    <link rel="stylesheet" href="/styles/student.css" />
  </head>
  <body>
    <!-- HEADER -->
    <header class="header">
      <div class="header-left">
        <h1>Student Dashboard</h1>
      </div>
      <a onclick="logout()" class="logout-btn">Logout</a>
    </header>

    <!-- HERO SECTION -->
    <section class="hero">
      <div class="hero-content">
        <h2>Find Lecturer and Book Appointment</h2>
        <p>
          Select your preferred lecturer and available time slot to book an
          appointment easily.
        </p>
      </div>

      <div class="hero-image">
        <img src="/assets/welcome.jpg" alt="Hero Image" class="heroImg" />
      </div>
    </section>

    <!-- MAIN CONTENT -->
    <main class="container">
      <h2 class="section-title">Available Lecturers</h2>

      <div class="teacher-list" id="teacherList"></div>
    </main>

    <!-- modal -->
    <div id="bookingModal" class="modal">
      <div class="modal-content">
        <h3>Book Appointment</h3>

        <input type="datetime-local" id="appointmentDate" />
        <textarea id="appointmentMessage" placeholder="Message"></textarea>

        <button onclick="submitAppointment()">Submit</button>
        <button onclick="closeModal()">Cancel</button>
      </div>
    </div>

    <!-- FOOTER -->
    <footer class="footer">
      <p>© 2026 Appointment System. All rights reserved.</p>
    </footer>
    <script src="/js/student.js"></script>
  </body>
</html>
