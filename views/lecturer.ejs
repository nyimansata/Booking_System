<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lecturer Dashboard</title>
    <link rel="stylesheet" href="/styles/lecturer.css" />
  </head>
  <body>
    <!-- HEADER -->
    <header class="header">
      <div class="header-left">
        <h1>Lecturer Dashboard</h1>
      </div>
      <a href="/logout" class="logout-btn">Logout</a>
    </header>

    <!-- MAIN -->
    <main class="container">
      <h2 class="page-title">Student Appointments</h2>

      <div class="appointment-list">
        <!-- Appointment Card -->
        <div class="appointment-card">
          <div class="appointment-info">
            <h3>John Doe</h3>
            <p><strong>Department:</strong> Computer Science</p>
            <p><strong>Subject:</strong> Data Structures</p>
            <p><strong>Date & Time:</strong> 12 Feb 2026, 10:00 AM</p>
          </div>

          <div class="appointment-actions">
            <button class="approve-btn">Approve</button>
            <button class="reject-btn">Reject</button>
          </div>
        </div>

        <div class="appointment-card">
          <div class="appointment-info">
            <h3>Mary Johnson</h3>
            <p><strong>Department:</strong> Mathematics</p>
            <p><strong>Subject:</strong> Linear Algebra</p>
            <p><strong>Date & Time:</strong> 14 Feb 2026, 2:30 PM</p>
          </div>

          <div class="appointment-actions">
            <button class="approve-btn">Approve</button>
            <button class="reject-btn">Reject</button>
          </div>
        </div>
      </div>
    </main>

    <!-- FOOTER -->
    <footer class="footer">
      <p>© 2026 Appointment System. All rights reserved.</p>
    </footer>
  </body>
</html>
